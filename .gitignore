!analysis/berry_cmf_validation/**/*.yaml
!analysis/berry_cmf_validation/**/*.yml
!analysis/berry_cmf_validation/**/*.md
!analysis/berry_cmf_validation/**/*.parquet
!analysis/berry_cmf_validation/**/*.json

