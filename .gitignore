# Python
__pycache__/
*.pyc
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# Logs / outputs
*.log
slurm-*.out
*.out
*.err
runs/
outputs/
output/
tmp/
wandb/

# OS/editor
.DS_Store
.vscode/
EOF

# Ignore build artifacts
bin/
obj/

# Ignore editor-specific files
.vscode/
.idea/

# Ignore log files
*.log

# Ignore temporary files
*.tmp

# Ignore .csv
*.csv
*.parquet
*.json
core.*

# Large local source datasets (ATTOM, assessor, Census, GIS, Berry/CMF)
data/ATTOM/
data/CCAO/
data/CensusData/
data/dewey-downloads/
data/geo/
data/berry_cmf/

# Track compact Berry/CMF audit artifacts despite global csv/parquet/json ignores.
# Raw/derived data remain under data/berry_cmf/ (ignored above).
!analysis/berry_cmf_validation/
!analysis/berry_cmf_validation/**
!analysis/berry_cmf_validation/**/*.csv
!analysis/berry_cmf_validation/**/*.yaml
!analysis/berry_cmf_validation/**/*.yml
!analysis/berry_cmf_validation/**/*.md
!analysis/berry_cmf_validation/**/*.parquet
!analysis/berry_cmf_validation/**/*.json
# Re-ignore compiled bytecode: the blanket un-ignore above otherwise defeats the
# global __pycache__/ and *.pyc rules for this subtree, which is how three .pyc
# files became tracked here. Mirrors the v2 and v3 blocks below.
analysis/berry_cmf_validation/**/__pycache__/
analysis/berry_cmf_validation/**/*.pyc

# Track compact Berry/ATTOM v2 audit artifacts. Large derived parquet stays
# under output/berry_attom_validation_v2/ (ignored via output/) or is
# re-ignored below. Never commit cookies/credentials.
!analysis/berry_attom_validation_v2/
!analysis/berry_attom_validation_v2/**
!analysis/berry_attom_validation_v2/**/*.csv
!analysis/berry_attom_validation_v2/**/*.yaml
!analysis/berry_attom_validation_v2/**/*.yml
!analysis/berry_attom_validation_v2/**/*.md
!analysis/berry_attom_validation_v2/**/*.json
!analysis/berry_attom_validation_v2/**/*.py
!analysis/berry_attom_validation_v2/**/*.sh
analysis/berry_attom_validation_v2/**/*.parquet
analysis/berry_attom_validation_v2/logs/
analysis/berry_attom_validation_v2/**/__pycache__/
analysis/berry_attom_validation_v2/**/*.pyc

# Track compact Berry/ATTOM v3 audit artifacts. Large derived parquet stays
# under output/berry_attom_validation_v3/ (ignored via output/).
!analysis/berry_attom_validation_v3/
!analysis/berry_attom_validation_v3/**
!analysis/berry_attom_validation_v3/**/*.csv
!analysis/berry_attom_validation_v3/**/*.yaml
!analysis/berry_attom_validation_v3/**/*.yml
!analysis/berry_attom_validation_v3/**/*.md
!analysis/berry_attom_validation_v3/**/*.json
!analysis/berry_attom_validation_v3/**/*.py
!analysis/berry_attom_validation_v3/**/*.sh
analysis/berry_attom_validation_v3/**/*.parquet
analysis/berry_attom_validation_v3/logs/
analysis/berry_attom_validation_v3/**/__pycache__/
analysis/berry_attom_validation_v3/**/*.pyc

# Track compact external-jurisdiction-benchmark-v1 audit artifacts. Large
# derived parquet stays under output/external_jurisdiction_benchmark_v1/
# (ignored via output/).
!analysis/external_jurisdiction_benchmark_v1/
!analysis/external_jurisdiction_benchmark_v1/**
!analysis/external_jurisdiction_benchmark_v1/**/*.csv
!analysis/external_jurisdiction_benchmark_v1/**/*.yaml
!analysis/external_jurisdiction_benchmark_v1/**/*.yml
!analysis/external_jurisdiction_benchmark_v1/**/*.md
!analysis/external_jurisdiction_benchmark_v1/**/*.json
!analysis/external_jurisdiction_benchmark_v1/**/*.py
!analysis/external_jurisdiction_benchmark_v1/**/*.sh
!analysis/external_jurisdiction_benchmark_v1/**/*.tex
analysis/external_jurisdiction_benchmark_v1/**/*.parquet
analysis/external_jurisdiction_benchmark_v1/logs/
analysis/external_jurisdiction_benchmark_v1/**/__pycache__/
analysis/external_jurisdiction_benchmark_v1/**/*.pyc

# Accidental empty files created by misparsed CLI flags
/--data-path
/--out-dir

# Ignore outputs
2025_assessment_python/outputs
2025_assessment_python/logs
2025_assessment_python/img

# ---------------------------------------------------------------------------
# P0 major-revision validation: narrowly scoped exception so the compact
# machine-readable scientific evidence is reproducible from Git.
# Applies ONLY under analysis/p0_major_revision_validation/.
# Row-level predictions, parquet twins and Slurm streams stay ignored.
# ---------------------------------------------------------------------------
!analysis/p0_major_revision_validation/
!analysis/p0_major_revision_validation/**/
!analysis/p0_major_revision_validation/**/*.csv
!analysis/p0_major_revision_validation/**/*.json
!analysis/p0_major_revision_validation/**/*.yaml
!analysis/p0_major_revision_validation/**/*.yml
!analysis/p0_major_revision_validation/**/*.md
!analysis/p0_major_revision_validation/**/*.py
!analysis/p0_major_revision_validation/**/*.sh
!analysis/p0_major_revision_validation/**/*.sbatch
!analysis/p0_major_revision_validation/**/*.patch
!analysis/p0_major_revision_validation/**/*.txt
# keep ignoring bulky / stream artifacts even under the P0 subtree
analysis/p0_major_revision_validation/**/*.parquet
analysis/p0_major_revision_validation/**/*.out
analysis/p0_major_revision_validation/**/*.err
analysis/p0_major_revision_validation/**/*.log
analysis/p0_major_revision_validation/**/__pycache__/

# ---------------------------------------------------------------------------
# P1 inferential-reporting exception (mirrors the P0 block above).
# Applies ONLY under analysis/p1_inferential_reporting/.
# Compact machine-readable evidence is tracked; bulky twins and logs are not.
# The IAAO ED2 PDF stays ignored via the deeper .gitignore in
# provenance/ed2_source_cache/ -- it is NOT redistributed in this repository.
!analysis/p1_inferential_reporting/
!analysis/p1_inferential_reporting/**/
!analysis/p1_inferential_reporting/**/*.csv
!analysis/p1_inferential_reporting/**/*.json
!analysis/p1_inferential_reporting/**/*.yaml
!analysis/p1_inferential_reporting/**/*.yml
!analysis/p1_inferential_reporting/**/*.md
!analysis/p1_inferential_reporting/**/*.py
!analysis/p1_inferential_reporting/**/*.sh
!analysis/p1_inferential_reporting/**/*.sbatch
!analysis/p1_inferential_reporting/**/*.txt

analysis/p1_inferential_reporting/**/*.parquet
analysis/p1_inferential_reporting/**/*.out
analysis/p1_inferential_reporting/**/*.err
analysis/p1_inferential_reporting/**/*.log
analysis/p1_inferential_reporting/**/__pycache__/

# ---------------------------------------------------------------------------
# Tier-B0 final manuscript evidence integration (mirrors the P0/P1 blocks above).
# Applies ONLY under analysis/final_manuscript_evidence/. Only *.csv and *.json
# are globally ignored among the formats this area uses (.md/.py/.yaml/.bib are
# not), so the exception is deliberately narrow.
# ---------------------------------------------------------------------------
!analysis/final_manuscript_evidence/**/*.csv
!analysis/final_manuscript_evidence/**/*.json

analysis/final_manuscript_evidence/**/*.parquet
analysis/final_manuscript_evidence/**/__pycache__/
